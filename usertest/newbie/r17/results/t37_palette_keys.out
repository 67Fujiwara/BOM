"次の問題" -> ["チェック次の問題へAlt+nF8"]
"確認済" -> ["チェック警告を確認済みにする / 外すAlt+x"]
"置換" -> ["BOM操作置き換え品を作るAlt+r"]
"隠す" -> ["表示列の表示・非表示Alt+c","編集行を隠す / 隠した行を戻す隠した行は 1 すべてに薄く出ますAlt+h"]
"並び替え" -> ["表示今の列で並び替えID の列で s 昇順 / Shift+S 降順（ほかの列では Alt+s / Alt+Shift+S）。列見出しのクリックでもAlt+s","BOM操作今の列で並び替え（降順）Alt+Shift+S"]
"発注" -> ["BOM操作発注済の切り替えAlt+o","購買キャンセル不可で発注に戻す（発注後変更依頼のあと）","ビュービュー: 発注・入荷Alt+3"]
"指摘" -> ["流れ指摘を起票（種別は頭文字）Alt+Shift+I","流れ指摘に返信Alt+Shift+R","流れ指摘を差戻し（専用）Alt+Shift+X"]
"採用" -> ["BOM操作推奨（最高スコア）で採用。見積済のみAlt+a","流れ未採用を推奨で一括採用","流れ未採用を最安で一括採用（スコア無視）"]
"最安" -> ["BOM操作最安で採用（スコア無視）。見積中なら先行採用Ctrl+Alt+A","流れ未採用を最安で一括採用（スコア無視）"]
"alt" -> ["表示ショートカット一覧（ヘルプ）Alt+?F1","表示今の列で並び替えID の列で s 昇順 / Shift+S 降順（ほかの列では Alt+s / Alt+Shift+S）。列見出しのクリックでもAlt+s"]
"Alt" -> ["表示ショートカット一覧（ヘルプ）Alt+?F1","表示今の列で並び替えID の列で s 昇順 / Shift+S 降順（ほかの列では Alt+s / Alt+Shift+S）。列見出しのクリックでもAlt+s"]
"F8" -> ["表示ショートカット一覧（ヘルプ）Alt+?F1"]
"英字" -> ["表示ショートカット一覧（ヘルプ）Alt+?F1"]
