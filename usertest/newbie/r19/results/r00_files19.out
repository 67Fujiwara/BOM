[f2_change_form_note_words.xlsx]
  old: tsv="\t変更前\t変更後\t\t\n品名\t型式\t型式\t数量\t備考\nリレー\tMY2N\tMY4N-D2\t4\t型式変更\nタイマ\tH3CR-A8\t\t1\t削除しました\nソケット\tPYF14A\t\t2\t不要のため削除\nランプ\tL-1\t\t1\t削除はしない\nヒューズ\tF-5A\t\t3\t欠番\n端子台\tXW2B-20G4\t\t4\t"
