  [ArrowDown] mode=edit cur=R030/altPolicy edit="不可" 強調=不可 cands=[不可 客先承認要 可 同等品可] | toast: null
  [ArrowDown] mode=edit cur=R030/altPolicy edit="客先承認要" 強調=客先承認要 cands=[客先承認要 可 同等品可 不可] | toast: null
  [Enter] mode=nav cur=R031/altPolicy edit="客先承認要" 強調=- cands=[] | toast: null
  R030: {"altPolicy":"客先承認要"}
